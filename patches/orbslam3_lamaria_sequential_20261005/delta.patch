+namespace {
+// sequential (2026-10-05): deterministic offline mode. After every keyframe insertion the tracker
+// waits until the local mapper has drained its queue and is idle again, so map growth never races
+// frame processing. Two byte-identical Medium runs scored 78.59 and 25.35 from thread timing alone;
+// this removes that lottery and keeps the map current when the next keyframe is needed. Offline
+// processing makes the wait free. LAMARIA_SEQUENTIAL=0 disables. The wait gives up after
+// kSequentialTimeoutSeconds (logged) so a stopped or finished mapper can never deadlock tracking.
+bool SequentialEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("LAMARIA_SEQUENTIAL");
+        return !(value && std::string(value) == "0");
+    }();
+    return enabled;
+}
+const double kSequentialTimeoutSeconds = 60.0;
+bool g_sequentialPending = false;
+void SequentialMarkPending() { if(SequentialEnabled()) g_sequentialPending = true; }
+// Called at the start of Track(), BEFORE the frame takes the map-update mutex: the mapper needs that
+// mutex to process the keyframe, so waiting while holding it would deadlock (first replay: 600 s timeout).
+void SequentialWaitIfPending(ORB_SLAM3::LocalMapping* mapper, double timestamp) {
+    if(!SequentialEnabled() || !mapper || !g_sequentialPending) return;
+    g_sequentialPending = false;
+    static long waits = 0; static double totalWait = 0.0, maxWait = 0.0; static long timeouts = 0;
+    const auto start = std::chrono::steady_clock::now();
+    bool timedOut = false;
+    while(true) {
+        if(mapper->isStopped() || mapper->stopRequested() || mapper->isFinished() || mapper->IsInitializing()) break;   // init runs its own keyframe loop
+        if(mapper->KeyframesInQueue() == 0 && mapper->AcceptKeyFrames()) break;
+        const double waited = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        if(waited > kSequentialTimeoutSeconds) { timedOut = true; break; }
+        usleep(500);
+    }
+    const double waited = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    ++waits; totalWait += waited; if(waited > maxWait) maxWait = waited; if(timedOut) ++timeouts;
+    if(timedOut) std::cout << std::setprecision(12) << "[SEQUENTIAL] t=" << timestamp << " timeout after " << waited << " s" << std::endl;
+    if(waits % 200 == 1) std::cout << std::setprecision(12) << "[SEQUENTIAL] t=" << timestamp << " waits=" << waits
+                                   << " total_wait_s=" << totalWait << " max_wait_s=" << maxWait << " timeouts=" << timeouts << std::endl;
+}
+}  // namespace
+
+namespace {
+// coastguard (2026-10-04). Pure inertial propagation during a coast diverged
+// to 6-41 m/s within 14 s on Medium (868-882 s) from a poisoned velocity/bias
+// left by a failed visual update; a head-worn pedestrian never exceeds ~3 m/s.
+// Bound the propagated body speed while coasting so landmarks stay findable.
+// LAMARIA_COAST_GUARD=0 disables. File scope: frozen Tracking.h layout.
+const float kCoastGuardMaxSpeed = 3.0f;   // m/s, walking/jogging bound
+bool CoastGuardEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("LAMARIA_COAST_GUARD");
+        return !(value && std::string(value) == "0");
+    }();
+    return enabled;
+}
+void CoastGuardVelocity(Eigen::Vector3f& velocity, double timestamp) {
+    const float speed = velocity.norm();
+    if(speed > kCoastGuardMaxSpeed) {
+        velocity *= kCoastGuardMaxSpeed / speed;
+        static long fires = 0;
+        if(++fires % 20 == 1)
+            std::cout << std::setprecision(12) << "[COAST_GUARD] t=" << timestamp << " propagated speed " << speed
+                      << " m/s bounded to " << kCoastGuardMaxSpeed << std::endl;
+    }
+}
+}
