+    const double cutoff=std::max(1e-10,eig.eigenvalues().maxCoeff()*1e-9);
+    const Eigen::VectorXd projected=eig.eigenvectors().transpose()*gradient;
+    double variance=0,nullComponent=0;
+    for(int i=0;i<dimension;++i) {
