+    std::map<const VertexPose*,int> poseIndex;
+    for(int i=1;i<N;++i) poseIndex[poses[i]]=poseBase+6*(i-1);
+    for(size_t i=0;i<imuEdges.size();++i) {
+        auto* e=imuEdges[i];e->computeError();Eigen::Vector3d rho(e->chi2(),1,0);
