+bool Tracking::ReanchorFramePoseHistory(KeyFrame* oldAnchor, KeyFrame* temporalSuccessor)
+{
+    if(!oldAnchor || !temporalSuccessor || oldAnchor==temporalSuccessor)
+        return false;
+    Map* map = oldAnchor->GetMap();
+    if(!map) return false;
+    // Track/history capture and inertial scale updates use this same mutex.
+    // KeyFrameCulling calls here before disconnecting the temporal chain.
+    unique_lock<mutex> lock(map->mMutexMapUpdate);
+    if(oldAnchor->isBad() || temporalSuccessor->isBad() ||
+       oldAnchor->GetMap()!=map || temporalSuccessor->GetMap()!=map ||
+       temporalSuccessor->mTimeStamp<=oldAnchor->mTimeStamp)
+        return false;
+    const Sophus::SE3f ToldNew = oldAnchor->GetPose() * temporalSuccessor->GetPoseInverse();
+    auto pose = mlRelativeFramePoses.begin();
+    size_t changed = 0;
+    for(auto reference=mlpReferences.begin(); reference!=mlpReferences.end(); ++reference,++pose) {
+        if(pose==mlRelativeFramePoses.end())
+            throw std::runtime_error("Inconsistent tracking history lengths");
+        if(*reference==oldAnchor) {
+            // T_frame_old * T_old_new * T_new_world == T_frame_world.
+            // Neither the current pose nor optimization's spanning tree changes.
+            *pose = (*pose) * ToldNew;
+            *reference = temporalSuccessor;
+            ++changed;
+        }
+    }
+    if(pose!=mlRelativeFramePoses.end())
+        throw std::runtime_error("Inconsistent tracking history lengths");
+    static const bool historyDiagnostic = [] {
+        const char* value = std::getenv("LAMARIA_HISTORY_DIAGNOSTICS");
+        return value && std::string(value)!="0";
+    }();
+    if(historyDiagnostic)
+        std::fprintf(stderr, "[HISTORY_REANCHOR_DIAG] {\"map\":%lu,\"old_id\":%lu,\"old_t\":%.9f,\"new_id\":%lu,\"new_t\":%.9f,\"rows\":%zu}\n",
+            map->GetId(), oldAnchor->mnId, oldAnchor->mTimeStamp,
+            temporalSuccessor->mnId, temporalSuccessor->mTimeStamp, changed);
+    return true;
+}
