+        for(int j=0;j<dimension;++j) {
+            if(eig.eigenvalues()[j]>cutoff) v+=projectedCalibration[j]*projectedCalibration[j]/eig.eigenvalues()[j];
+            else n+=projectedCalibration[j]*projectedCalibration[j];
+        }
+        if(n<=std::max(1e-14,physicalGradient.squaredNorm()*1e-6) && v>=0 && std::isfinite(v))
