+    if(nullComponent>std::max(1e-14,gradient.squaredNorm()*1e-6) || !std::isfinite(variance) || variance<0) return;
+    result.jointLogBaselineStdDev=std::sqrt(variance);
+    if(freeRadial) for(int camera=0;camera<2;++camera) for(int coefficient=0;coefficient<2;++coefficient) {
+        const int index=radialBase+2*camera+coefficient;
+        Eigen::VectorXd physicalGradient=Eigen::VectorXd::Zero(dimension);
