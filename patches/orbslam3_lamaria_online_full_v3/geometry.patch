+namespace {
+// The cam0 bearing is invariant under a global visual-map rescale. Its cam1
+// prediction is not, because the calibrated stereo baseline stays in metres.
+class EdgeMetricRigScale : public g2o::BaseUnaryEdge<2,Eigen::Vector2d,VertexScale> {
+public:
+    EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+    EdgeMetricRigScale(GeometricCamera* camera, const Eigen::Vector3d& rotatedPoint,
+                       const Eigen::Vector3d& translation)
+        : camera_(camera), rotatedPoint_(rotatedPoint), translation_(translation) {}
+    bool read(std::istream&) override { return false; }
+    bool write(std::ostream&) const override { return false; }
+    void computeError() override {
+        const double scale=static_cast<const VertexScale*>(_vertices[0])->estimate();
+        const Eigen::Vector3d pc=scale*rotatedPoint_+translation_;
+        if(!pc.allFinite() || pc.z()<=0) { _error.setConstant(1e3); return; }
+        _error=camera_->project(pc)-_measurement;
+        if(!_error.allFinite()) _error.setConstant(1e3);
+    }
+    void linearizeOplus() override {
+        const double scale=static_cast<const VertexScale*>(_vertices[0])->estimate();
+        const Eigen::Vector3d pc=scale*rotatedPoint_+translation_;
+        _jacobianOplusXi.setZero();
+        if(pc.allFinite() && pc.z()>0)
+            _jacobianOplusXi=camera_->projectJac(pc)*(scale*rotatedPoint_);
+        if(!_jacobianOplusXi.allFinite()) _jacobianOplusXi.setZero();
+    }
+    double scaleInformation() {
+        computeError();linearizeOplus();
+        Eigen::Vector3d rho(chi2(),1,0);
+        if(robustKernel()) robustKernel()->robustify(chi2(),rho);
+        return rho[1]*(_jacobianOplusXi.transpose()*information()*_jacobianOplusXi)(0,0);
+    }
+private:
+    GeometricCamera* camera_;
+    Eigen::Vector3d rotatedPoint_,translation_;
+};
+
+double MetricInitMedian(std::vector<double> values) {
+    if(values.empty()) return std::numeric_limits<double>::infinity();
+    const size_t middle=values.size()/2;
+    std::nth_element(values.begin(),values.begin()+middle,values.end());
+    const double hi=values[middle];
+    return values.size()%2 ? hi : 0.5*(hi+*std::max_element(values.begin(),values.begin()+middle));
+}
+
+// Scale is entry eight; all other variables are nuisance variables. Diagonal
+// normalization avoids mixing metres, radians, seconds and bias units in the
+// rank decision. Pseudoinversion preserves genuine gauge freedoms.
+double MetricInitScaleSigma(const Eigen::MatrixXd& hessian) {
+    if(hessian.rows()<9 || !hessian.allFinite() || hessian(8,8)<=0)
+        return std::numeric_limits<double>::infinity();
+    const int n=hessian.rows()-1;
+    Eigen::MatrixXd A(n,n);Eigen::VectorXd b(n);
+    for(int r=0;r<n;++r) {
+        const int rr=r<8?r:r+1;b[r]=hessian(rr,8);
+        for(int c=0;c<n;++c) A(r,c)=hessian(rr,c<8?c:c+1);
+    }
+    Eigen::VectorXd normalizer(n);
+    for(int i=0;i<n;++i) normalizer[i]=1.0/std::sqrt(std::max(1e-15,A(i,i)));
+    A=normalizer.asDiagonal()*A*normalizer.asDiagonal();
+    b=normalizer.asDiagonal()*b;
+    Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> eig((A+A.transpose())*0.5);
+    if(eig.info()!=Eigen::Success) return std::numeric_limits<double>::infinity();
+    const double cutoff=std::max(1e-10,eig.eigenvalues().maxCoeff()*1e-9);
+    const Eigen::VectorXd projected=eig.eigenvectors().transpose()*b;
+    double eliminated=0;
+    for(int i=0;i<n;++i) if(eig.eigenvalues()[i]>cutoff)
+        eliminated+=projected[i]*projected[i]/eig.eigenvalues()[i];
+    const double information=hessian(8,8)-eliminated;
+    if(!(information>std::max(1e-10,hessian(8,8)*1e-9)))
+        return std::numeric_limits<double>::infinity();
+    return 1.0/std::sqrt(information);
+}
