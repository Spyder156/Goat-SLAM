+MetricRigScaleObservations CollectRigScaleObservations(
+    Frame& first, Frame& current,
+    const std::vector<Eigen::Vector3f>& worldPoints,
+    const std::vector<int>& matches,
+    const Sophus::SE3f& firstPose, const Sophus::SE3f& currentPose)
+{
+    MetricRigScaleObservations observations;
+    Frame* frames[2] = {&first, &current};
+    const Sophus::SE3f poses[2] = {firstPose, currentPose};
+    for(size_t i=0; i<matches.size() && i<worldPoints.size(); ++i) {
+        if(matches[i]<0 || !worldPoints[i].allFinite()) continue;
+        for(int cameraTime=0; cameraTime<2; ++cameraTime) {
+            Frame& frame=*frames[cameraTime];
+            const int left=cameraTime==0 ? static_cast<int>(i) : matches[i];
+            if(left<0 || left>=frame.Nleft) continue;
+            const int right=frame.mvLeftToRightMatch[left];
+            if(right<0) continue;
+            MetricRigScaleObservation observation;
+            observation.landmarkId=i;
+            observation.bootstrapPointCam0=(poses[cameraTime]*worldPoints[i]).cast<double>();
+            observation.metricStereoPointCam0=frame.mvStereo3Dpoints[left].cast<double>();
+            observation.pixelCam0=Eigen::Vector2d(frame.mvKeys[left].pt.x,frame.mvKeys[left].pt.y);
+            observation.pixelCam1=Eigen::Vector2d(frame.mvKeysRight[right].pt.x,frame.mvKeysRight[right].pt.y);
+            const Sophus::SE3f relative=frame.GetRelativePoseTrl();
+            observation.R10=relative.rotationMatrix().cast<double>();
+            observation.t10Metres=relative.translation().cast<double>();
+            observation.camera0=frame.mpCamera;
+            observation.camera1=frame.mpCamera2;
+            observations.push_back(observation);
+        }
+    }
+    return observations;
+}
+void AddMetricRigObservations(KeyFrame* keyFrame, Frame& frame)
+{
+    for(int left=0; left<frame.Nleft; ++left) {
+        const int right=frame.mvLeftToRightMatch[left];
+        if(right<0) continue;
+        MapPoint* point=keyFrame->GetMapPoint(left);
+        if(!point || point->isBad()) continue;
+        if(std::get<1>(point->GetIndexInKeyFrame(keyFrame)) != -1) continue;
+        const Eigen::Vector3f pc1=keyFrame->GetRightPose()*point->GetWorldPos();
+        if(pc1.z()<=0) continue;
+        const Eigen::Vector2f uv=frame.mpCamera2->project(pc1);
+        const cv::Point2f measured=frame.mvKeysRight[right].pt;
+        if(!uv.allFinite() || (uv-Eigen::Vector2f(measured.x,measured.y)).squaredNorm()>6.25f) continue;
+        const int index=frame.Nleft+right;
+        if(keyFrame->GetMapPoint(index)) continue;
+        point->AddObservation(keyFrame,index);
+        if(std::get<1>(point->GetIndexInKeyFrame(keyFrame)) != index) continue;
+        keyFrame->AddMapPoint(point,index);
+        frame.mvpMapPoints[index]=point;
+        frame.mvbOutlier[index]=false;
+        point->ComputeDistinctiveDescriptors();
+        point->UpdateNormalAndDepth();
+    }
+}
