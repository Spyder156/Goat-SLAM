+// Full pose/velocity/bias/gravity information after landmark elimination.
+// This tests a physical camera-baseline length, rather than inventing another
+// independent scale vertex alongside freely movable cameras and landmarks.
+void JointMetricConditioning(const std::vector<VertexPose*>& poses,
+    const std::vector<EdgeInertialGS*>& imuEdges,
+    const std::vector<std::pair<size_t,size_t>>& imuLinks,
+    const std::vector<std::vector<JointMetricVisualEdge>>& pointEdges,
+    const std::vector<VertexRadialCalibration*>& radialVertices,
+    MetricInertialInitResult& result)
+{
+    const int N=poses.size(),poseBase=8+3*N,radialBase=poseBase+6*(N-1);
+    const bool freeRadial=!radialVertices.empty() && !radialVertices[0]->fixed();
+    const int dimension=radialBase+(freeRadial?4:0);
