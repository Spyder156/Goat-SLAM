+        if(imuLinks[i].first) for(int j=0;j<6;++j) index[15+j]=poseBase+6*(imuLinks[i].first-1)+j;
+        if(imuLinks[i].second) for(int j=0;j<6;++j) index[21+j]=poseBase+6*(imuLinks[i].second-1)+j;
+        for(int r=0;r<27;++r) if(index[r]>=0) for(int c=0;c<27;++c) if(index[c]>=0)
