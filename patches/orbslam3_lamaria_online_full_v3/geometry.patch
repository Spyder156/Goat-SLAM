+void Tracking::RefreshFullCalibration(const std::map<KeyFrame*,Sophus::SE3f>& oldPoses,const std::map<KeyFrame*,Eigen::Vector3f>& oldVelocities)
+{
+    std::set<ConstraintPoseImu*> oldPriors;
+    Frame* frames[3]={&mCurrentFrame,&mLastFrame,&mInitialFrame};
+    for(Frame* f:frames) {
+        if(f->mpcpi)oldPriors.insert(f->mpcpi);
+        f->mpcpi=nullptr;
+        if(f->isSet()) {
+            KeyFrame* anchor=f->mpReferenceKF;
+            if(!anchor || oldPoses.count(anchor)==0)anchor=f->mpLastKeyFrame;
+            if(anchor && oldPoses.count(anchor)) {
+                const Sophus::SE3f old=oldPoses.at(anchor),now=anchor->GetPose();
+                f->SetPose(f->GetPose()*old.inverse()*now);
+                f->SetVelocity(TransportFrameVelocity(f->GetVelocity(),oldVelocities.at(anchor),anchor->GetVelocity(),now.rotationMatrix().transpose()*old.rotationMatrix()));
+                // Bias belongs to the integration's temporal anchor, which
+                // need not be the visual reference used for pose transport.
+                KeyFrame* imuAnchor=f->mpLastKeyFrame;
+                if(imuAnchor && oldPoses.count(imuAnchor))f->SetNewBias(imuAnchor->GetImuBias());
+                else f->SetNewBias(anchor->GetImuBias());
+            }
+        }
+        f->RefreshStereoGeometryAfterCalibration();
+    }
+    // Frame-to-frame integration starts at the previous Frame bias; the
+    // long keyframe integration bias is refreshed by SetNewBias above.
+    if(mCurrentFrame.mpImuPreintegratedFrame)mCurrentFrame.mpImuPreintegratedFrame->SetNewBias(mLastFrame.mImuBias);
+    for(auto* prior:oldPriors)delete prior;
+    mK=mpCamera->toK();mbf=mCurrentFrame.mbf;
+    mLastBias=mLastFrame.mImuBias;
+    mbVelocity=false;mbMapUpdated=true;
+}
