+    bool isDepthPositive() const {return native?native->isDepthPositive():radial->isDepthPositive();}
+    VertexPose* pose() const {return static_cast<VertexPose*>(edge()->vertex(1));}
+    Eigen::MatrixXd hessian() const {if(native) return native->GetHessian();return radial->GetHessian();}
