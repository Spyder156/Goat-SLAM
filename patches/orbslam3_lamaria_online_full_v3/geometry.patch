+    int camera=0, radialBin=0;
+    g2o::OptimizableGraph::Edge* edge() const {return native?static_cast<g2o::OptimizableGraph::Edge*>(native):static_cast<g2o::OptimizableGraph::Edge*>(radial);}
+    void computeError() const {edge()->computeError();}
