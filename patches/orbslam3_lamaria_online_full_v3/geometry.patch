+// Re-express an immutable ImuCamPose in metric units without scaling either
+// calibrated camera/body or camera/camera translations.
+ImuCamPose MetricInitScaledPose(const ImuCamPose& source,double scale) {
+    ImuCamPose pose=source;
+    pose.twb=scale*source.twb+(scale-1.0)*source.Rwb*source.tbc[0];
+    const Eigen::Matrix3d Rbw=pose.Rwb.transpose();
+    for(size_t camera=0;camera<pose.pCamera.size();++camera) {
+        pose.Rcw[camera]=pose.Rcb[camera]*Rbw;
+        pose.tcw[camera]=-pose.Rcw[camera]*pose.twb+pose.tcb[camera];
+    }
+    return pose;
+}
