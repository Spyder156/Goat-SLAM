+namespace {
+struct TemporalAssociationResult {
+    int validPrevious[2]={0,0}, candidates[2]={0,0};
+    std::vector<int> seeded;
+};
+
+// Match the immediately preceding appearance, preserving established landmark
+// IDs. IMU prediction and the existing joint geometric optimizer are unchanged.
+TemporalAssociationResult SeedTemporalLandmarks(Frame& previous, Frame& current, Map* map)
+{
+    TemporalAssociationResult result;
+    static const bool enabled=[] {
+        const char* value=std::getenv("LAMARIA_TEMPORAL_ASSOCIATIONS");
+        return value && std::string(value)!="0";
+    }();
+    if(!enabled || previous.Nleft<0 || current.Nleft<0 ||
+       current.mTimeStamp<=previous.mTimeStamp ||
+       current.mTimeStamp-previous.mTimeStamp>0.15) return result;
+    struct Candidate { int distance; int feature; MapPoint* point; };
+    for(int camera=0; camera<2; ++camera) {
+        const int oldOffset=camera ? previous.Nleft : 0;
+        const int newOffset=camera ? current.Nleft : 0;
+        const int oldCount=camera ? previous.Nright : previous.Nleft;
+        const int newCount=camera ? current.Nright : current.Nleft;
+        if(oldCount<2 || newCount<2 || previous.mDescriptors.type()!=CV_8U ||
+           current.mDescriptors.type()!=CV_8U || previous.mDescriptors.cols!=32 ||
+           current.mDescriptors.cols!=32 || previous.mDescriptors.rows<oldOffset+oldCount ||
+           current.mDescriptors.rows<newOffset+newCount) continue;
+        std::unordered_set<MapPoint*> occupied;
+        for(int k=0; k<newCount; ++k)
+            if(current.mvpMapPoints[newOffset+k]) occupied.insert(current.mvpMapPoints[newOffset+k]);
+        const cv::Mat oldDescriptors=previous.mDescriptors.rowRange(oldOffset,oldOffset+oldCount);
+        const cv::Mat newDescriptors=current.mDescriptors.rowRange(newOffset,newOffset+newCount);
+        cv::BFMatcher matcher(cv::NORM_HAMMING);
+        std::vector<std::vector<cv::DMatch>> forward;
+        std::vector<cv::DMatch> backward;
+        matcher.knnMatch(oldDescriptors,newDescriptors,forward,2);
+        matcher.match(newDescriptors,oldDescriptors,backward);
+        std::vector<Candidate> candidates;
+        for(int k=0; k<oldCount; ++k) {
+            const int oldIndex=oldOffset+k;
+            if(previous.mvbOutlier[oldIndex]) continue;
+            MapPoint* point=previous.mvpMapPoints[oldIndex];
+            if(!point || point->isBad() || point->GetMap()!=map ||
+               point->Observations()==0 || occupied.count(point)) continue;
+            ++result.validPrevious[camera];
+            if(static_cast<size_t>(k)>=forward.size() || forward[k].size()<2) continue;
+            const auto& best=forward[k][0];
+            if(best.distance>70.0f || best.distance>=0.8f*forward[k][1].distance ||
+               best.trainIdx<0 || best.trainIdx>=newCount ||
+               static_cast<size_t>(best.trainIdx)>=backward.size() ||
+               backward[best.trainIdx].trainIdx!=k) continue;
+            const int index=newOffset+best.trainIdx;
+            if(current.mvpMapPoints[index]) continue;
+            candidates.push_back({static_cast<int>(best.distance),index,point});
+        }
+        result.candidates[camera]=candidates.size();
+        std::sort(candidates.begin(),candidates.end(),[](const Candidate& a,const Candidate& b) {
+            if(a.distance!=b.distance) return a.distance<b.distance;
+            return a.feature<b.feature;
+        });
+        for(const Candidate& candidate:candidates) {
+            if(current.mvpMapPoints[candidate.feature] || occupied.count(candidate.point)) continue;
+            current.mvpMapPoints[candidate.feature]=candidate.point;
+            current.mvbOutlier[candidate.feature]=false;
+            occupied.insert(candidate.point);
+            result.seeded.push_back(candidate.feature);
+        }
+    }
+    return result;
+}
