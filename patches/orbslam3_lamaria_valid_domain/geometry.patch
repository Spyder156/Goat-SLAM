+void Tracking::StoreFramePoseHistory()
+{
+    if(mState==OK || mState==RECENTLY_LOST)
+    {
+        // Store frame pose information to retrieve the complete camera trajectory afterwards.
+        if(mCurrentFrame.isSet())
+        {
+            // The visual reference maximizes shared observations and can be
+            // an old revisit keyframe.  Inertial BA corrects the recent temporal
+            // chain; retain this frame relative to that same recent chain.
+            // Keep the visual reference unchanged for matching/local-map logic.
+            KeyFrame* pHistoryKF = mCurrentFrame.mpReferenceKF;
+            const bool inertial = mSensor==System::IMU_MONOCULAR ||
+                                  mSensor==System::IMU_STEREO || mSensor==System::IMU_RGBD;
+            if(inertial && mpLastKeyFrame && !mpLastKeyFrame->isBad() &&
+               mpLastKeyFrame->GetMap()==mpAtlas->GetCurrentMap())
+                pHistoryKF = mpLastKeyFrame;
+            Sophus::SE3f Tcr_ = mCurrentFrame.GetPose() * pHistoryKF->GetPoseInverse();
+            mlRelativeFramePoses.push_back(Tcr_);
+            mlpReferences.push_back(pHistoryKF);
+            static const bool historyDiagnostic = [] {
+                const char* value = std::getenv("LAMARIA_HISTORY_DIAGNOSTICS");
+                return value && std::string(value)!="0";
+            }();
+            if(historyDiagnostic) {
+                KeyFrame* visual = mCurrentFrame.mpReferenceKF;
+                std::fprintf(stderr, "[HISTORY_DIAG] {\"t\":%.9f,\"map\":%lu,\"visual_id\":%lld,\"visual_t\":%.9f,\"temporal_id\":%lld,\"temporal_t\":%.9f,\"anchor_id\":%lu,\"anchor_t\":%.9f}\n",
+                    mCurrentFrame.mTimeStamp, pHistoryKF->GetMap()->GetId(),
+                    visual ? static_cast<long long>(visual->mnId) : -1LL,
+                    visual ? visual->mTimeStamp : -1.,
+                    mpLastKeyFrame ? static_cast<long long>(mpLastKeyFrame->mnId) : -1LL,
+                    mpLastKeyFrame ? mpLastKeyFrame->mTimeStamp : -1.,
+                    pHistoryKF->mnId, pHistoryKF->mTimeStamp);
+            }
+            mlFrameTimes.push_back(mCurrentFrame.mTimeStamp);
+            mlbLost.push_back(mState==LOST);
+        }
+        else
+        {
+            // This can happen if tracking is lost
+            mlRelativeFramePoses.push_back(mlRelativeFramePoses.back());
+            mlpReferences.push_back(mlpReferences.back());
+            mlFrameTimes.push_back(mlFrameTimes.back());
+            mlbLost.push_back(mState==LOST);
+        }
+
+    }
+}
