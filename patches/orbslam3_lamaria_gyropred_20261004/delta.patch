+// gyropred / preinit-coast (2026-10-04). File-scope state because the frozen
+// Tracking.h class layout must stay identical for reused objects.
+// LAMARIA_GYRO_PREDICT=0 restores stock constant-velocity prediction before
+// IMU initialisation; LAMARIA_PREINIT_COAST=0 restores the immediate reset.
+bool GyroPredictionEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("LAMARIA_GYRO_PREDICT");
+        return !(value && std::string(value) == "0");
+    }();
+    return enabled;
+}
+bool PreInitCoastEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("LAMARIA_PREINIT_COAST");
+        return !(value && std::string(value) == "0");
+    }();
+    return enabled;
+}
+const double kPreInitCoastGraceSeconds = 1.0;   // Long first map: blur burst lasted ~0.5 s
+bool g_preInitCoast = false;
+int g_preInitCoastFrames = 0;
+
+// Predict the current camera pose before IMU initialisation: rotation from the
+// frame-to-frame gyro preintegration (bias is zero before init; ~1e-3 rad/s
+// over 50 ms is negligible), translation from the constant-velocity model.
+// Conventions: Rwb = world_from_body; mImuCalib.mTcb = cam_from_body;
+// Tcw = Tcb * Twb^-1. Returns false (pose untouched) without preintegration.
+bool GyroConstantVelocityPrediction(ORB_SLAM3::Frame& current, ORB_SLAM3::Frame& last, const Sophus::SE3f& velocity, bool hasVelocity)
+{
+    if(!last.isSet() || !current.mpImuPreintegratedFrame || current.mpImuPreintegratedFrame->dT <= 0.f)
+        return false;
+    const Sophus::SE3f TcwConstantVelocity = hasVelocity ? velocity * last.GetPose() : last.GetPose();
+    const Eigen::Matrix3f Rwb1 = last.GetImuRotation();
+    const Eigen::Matrix3f dR = current.mpImuPreintegratedFrame->GetDeltaRotation(last.mImuBias);
+    const Eigen::Matrix3f Rwb2 = ORB_SLAM3::IMU::NormalizeRotation(Rwb1 * dR);
+    const Sophus::SE3f TwbConstantVelocity = TcwConstantVelocity.inverse() * current.mImuCalib.mTcb;
+    const Sophus::SE3f Twb2(Rwb2, TwbConstantVelocity.translation());
+    current.SetPose(current.mImuCalib.mTcb * Twb2.inverse());
+    return true;
+}
+}
